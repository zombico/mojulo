{
  "name": "mojulo",
  "mcpName": "io.github.zombico/mojulo",
  "version": "2.0.4",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Mojulo — a 3D compiler for coding agents: a local MCP server where you build worlds, objects, and games by talking to the agent you already run (Claude Code, Codex, or any MCP host). Each one is stored as a small deterministic recipe on your own machine — the source, compiled back byte-for-byte and emitted as a game (Godot) or a printed object (STL). A compiler, not a generator; the recipe stays yours.",
  "author": "Franz Ombico",
  "homepage": "https://mojulo.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zombico/mojulo.git",
    "directory": "control"
  },
  "bugs": {
    "url": "https://github.com/zombico/mojulo/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "anthropic",
    "claude-code",
    "codex",
    "openai",
    "3d",
    "3d-printing",
    "stl",
    "godot",
    "gamedev",
    "procedural-generation",
    "generative",
    "worldbuilding",
    "self-hosted",
    "local-first",
    "ai-agent",
    "agent-tools",
    "mojulo",
    "gltf",
    "blender"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mojulo": "./scripts/mcp-stdio.mjs",
    "mojulo-config": "./scripts/mcp-config.mjs",
    "mojulo-ui": "./scripts/mcp-ui.mjs",
    "mojulo-app-runtime": "./bin/app-runtime.mjs",
    "mojulo-daemons": "./bin/daemons.mjs"
  },
  "files": [
    "lib/**",
    "!lib/embedder/models/**",
    "!lib/**/*.test.js",
    "components/graph/CreationMap.jsx",
    "bin/app-runtime.mjs",
    "bin/daemons.mjs",
    "scripts/mcp-stdio.mjs",
    "scripts/mcp-stdio-loader.mjs",
    "scripts/mcp-init.mjs",
    "scripts/mcp-install.mjs",
    "scripts/mcp-cli.mjs",
    "scripts/mcp-config.mjs",
    "scripts/mcp-ui.mjs",
    "scripts/mojulo-paths.mjs",
    "messages/**",
    "public/vendor/**",
    "lite-template/**",
    ".next/standalone/**",
    "!.next/standalone/.env",
    "!.next/standalone/.env.*",
    "!.next/standalone/data/**",
    "!.next/standalone/lib/embedder/models/**",
    "!.next/standalone/lite-template/**",
    "!.next/standalone/mojulo-*.tgz",
    "!.next/standalone/**/*.test.js",
    "!.next/standalone/node_modules/better-sqlite3/**",
    "!.next/standalone/node_modules/@img/**",
    "!.next/standalone/node_modules/onnxruntime-node/**",
    "!.next/standalone/node_modules/node-web-audio-api/**"
  ],
  "scripts": {
    "dev": "next dev -p 3001 --webpack",
    "dev:turbo": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "build:bot": "docker build -t mojulo/bot:latest ../lite-template",
    "mcp-stdio": "node scripts/mcp-stdio.mjs",
    "mcp-config": "node scripts/mcp-config.mjs",
    "mcp-ui": "node scripts/mcp-ui.mjs",
    "stage-lite-template": "node scripts/stage-lite-template.mjs",
    "stage-standalone": "node scripts/stage-standalone.mjs",
    "fetch-models": "node scripts/fetch-embed-model.js",
    "gen-app": "node scripts/gen-app.js",
    "prepack": "node scripts/stage-lite-template.mjs && NODE_OPTIONS=--max-old-space-size=8192 next build --webpack && node scripts/stage-standalone.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@puppeteer/browsers": "^2.13.2",
    "@swc/core": "^1.15.47",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "dotenv": "^17.2.3",
    "image-size": "^2.0.2",
    "isomorphic-dompurify": "^3.15.0",
    "officeparser": "^5.2.2",
    "open": "^11.0.0",
    "pdf2json": "^4.0.0",
    "puppeteer-core": "^23.11.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1"
  },
  "optionalDependencies": {
    "manifold-3d": "^3.5.1",
    "node-web-audio-api": "^2.0.0",
    "opentype.js": "^2.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "next": "^16.0.7",
    "next-intl": "^4.8.3",
    "tailwindcss": "^4",
    "vitest": "^4.1.6"
  }
}
