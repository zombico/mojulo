{
  "name": "mojulo",
  "version": "0.8.0",
  "license": "Apache-2.0",
  "description": "Mojulo — MCP server for building self-hosted chatbots from any MCP-capable agent (Claude Code, Codex, and friends).",
  "author": "Franz Ombico",
  "homepage": "https://github.com/zombico/mojulo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zombico/mojulo.git"
  },
  "bugs": {
    "url": "https://github.com/zombico/mojulo/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "anthropic",
    "claude-code",
    "codex",
    "openai",
    "chatbot",
    "bot-builder",
    "rag",
    "self-hosted",
    "mojulo"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mojulo": "./scripts/mcp-stdio.mjs",
    "mojulo-config": "./scripts/mcp-config.mjs",
    "mojulo-ui": "./scripts/mcp-ui.mjs"
  },
  "files": [
    "lib/**",
    "!lib/embedder/models/**",
    "!lib/**/*.test.js",
    "scripts/mcp-stdio.mjs",
    "scripts/mcp-stdio-loader.mjs",
    "scripts/mcp-config.mjs",
    "scripts/mcp-ui.mjs",
    "scripts/mojulo-paths.mjs",
    "messages/**",
    "lite-template/**",
    ".next/standalone/**",
    "!.next/standalone/.env",
    "!.next/standalone/.env.*",
    "!.next/standalone/data/**",
    "!.next/standalone/lib/embedder/models/**",
    "!.next/standalone/lite-template/**",
    "!.next/standalone/mojulo-*.tgz",
    "!.next/standalone/**/*.test.js"
  ],
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "build:bot": "docker build -t mojulo/bot:latest ../lite-template",
    "mcp-stdio": "node scripts/mcp-stdio.mjs",
    "mcp-config": "node scripts/mcp-config.mjs",
    "mcp-ui": "node scripts/mcp-ui.mjs",
    "stage-lite-template": "node scripts/stage-lite-template.mjs",
    "stage-standalone": "node scripts/stage-standalone.mjs",
    "fetch-models": "node scripts/fetch-embed-model.js",
    "prepack": "node scripts/stage-lite-template.mjs && next build --webpack && node scripts/stage-standalone.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1011.0",
    "@huggingface/transformers": "^4.2.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "next": "^16.0.7",
    "next-intl": "^4.8.3",
    "officeparser": "^5.2.2",
    "open": "^11.0.0",
    "pdf2json": "^4.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "vitest": "^4.1.6"
  }
}
