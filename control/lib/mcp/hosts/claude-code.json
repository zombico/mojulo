{
  "id": "claude-code",
  "adapterId": "claude-code",
  "order": 1,
  "name": "Claude Code",
  "detect": { "probe": ["claude", "--version"] },
  "wire": {
    "format": "cli-shellout",
    "cli": {
      "bin": "claude",
      "listArgs": ["mcp", "list"],
      "addArgs": ["mcp", "add", "--scope", "user", "mojulo", "--", "npx", "-y", "mojulo"],
      "removeLocalArgs": ["mcp", "remove", "-s", "local", "mojulo"]
    },
    "userScope": { "file": "~/.claude.json", "key": "mcpServers" }
  },
  "manual": "claude mcp add --scope user mojulo -- npx -y mojulo",
  "capabilities": {
    "defersToolSchemas": true,
    "maxOutputBytes": null,
    "nativeImageGen": false,
    "scheduler": "/schedule",
    "skillsDir": "~/.claude/skills",
    "headlessRuntime": "claude-code-headless"
  },
  "handoff": {
    "verified": "field",
    "local": { "page": "dashboard", "file": "local" },
    "box": {
      "name": "Claude Code on the web",
      "page": "artifact",
      "file": "artifact-download",
      "pageMaxBytes": 16777216,
      "fileMaxBytes": null,
      "downloadExtensions": ["gif", "png", "jpg", "jpeg", "webp", "mp4", "webm", "txt", "json", "md", "docx", "pptx", "epub", "csv", "ttf", "html", "svg", "pdf", "xlsx", "zip"],
      "supportingFileExtensions": ["html", "css", "js", "mjs", "wasm", "json", "map", "geojson", "webmanifest", "txt", "md", "csv", "xml", "svg", "png", "jpg", "jpeg", "gif", "webp", "avif", "ico", "woff", "woff2", "ttf", "otf", "mp3", "wav", "ogg", "mp4", "webm", "pdf"],
      "pageInitiatedDownloads": false,
      "rendersStructuredContentInsteadOfText": true,
      "cdns": ["cdnjs.cloudflare.com", "cdn.jsdelivr.net/npm/"],
      "egress": "git",
      "ephemeral": true
    }
  }
}
