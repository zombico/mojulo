{
  "_fill": {
    "notes": "ComfyUI API-format workflow template for the local render worker (local-render-worker.plan.md L2). Fill by STRING REPLACEMENT on the raw file text, then JSON.parse and POST { prompt: <the .prompt object> } to http://127.0.0.1:8188/prompt. Numeric slots are quoted placeholder strings — replace INCLUDING the surrounding quotes (e.g. '\"{{WIDTH}}\"' -> '1024') so the parsed JSON carries real numbers.",
    "slots": {
      "{{CHECKPOINT}}": "checkpoint filename in ComfyUI/models/checkpoints (e.g. sd_xl_base_1.0.safetensors or animagine-xl-3.1.safetensors)",
      "{{CONTROLNET_MODEL}}": "controlnet filename in ComfyUI/models/controlnet (e.g. controlnet-scribble-sdxl.safetensors)",
      "{{SCAFFOLD_IMAGE}}": "scaffold PNG filename previously uploaded via POST /upload/image (the packet's scaffold.pngUrl, fetched and uploaded)",
      "{{PROMPT}}": "localParams.promptFragments joined with ', ' + the agent's beat/subject distillation (JSON-escape it)",
      "{{NEGATIVE}}": "localParams.negative joined with ', ' (JSON-escape it)",
      "\"{{STRENGTH}}\"": "localParams.controlnet.strength (number)",
      "\"{{WIDTH}}\"": "localParams.size.width (number)",
      "\"{{HEIGHT}}\"": "localParams.size.height (number)",
      "\"{{SEED}}\"": "render-event seed (number) — record it with the bind; recipes stay timeless",
      "{{FILENAME_PREFIX}}": "e.g. <ref>-<target>"
    }
  },
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "{{CHECKPOINT}}" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{PROMPT}}", "clip": ["1", 1] }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{NEGATIVE}}", "clip": ["1", 1] }
    },
    "4": {
      "class_type": "LoadImage",
      "inputs": { "image": "{{SCAFFOLD_IMAGE}}" }
    },
    "5": {
      "class_type": "ControlNetLoader",
      "inputs": { "control_net_name": "{{CONTROLNET_MODEL}}" }
    },
    "6": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": ["2", 0],
        "negative": ["3", 0],
        "control_net": ["5", 0],
        "image": ["4", 0],
        "strength": "{{STRENGTH}}",
        "start_percent": 0.0,
        "end_percent": 0.55
      }
    },
    "7": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["6", 0],
        "negative": ["6", 1],
        "latent_image": ["7", 0],
        "seed": "{{SEED}}",
        "steps": 28,
        "cfg": 7.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["8", 0], "vae": ["1", 2] }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": { "images": ["9", 0], "filename_prefix": "{{FILENAME_PREFIX}}" }
    }
  }
}
