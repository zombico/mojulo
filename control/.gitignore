node_modules/
.next/
.env
.env.local
/data/
*.log
.DS_Store
lib/embedder/models/
# The dashboard package's build output, staged at pack time by
# scripts/stage-ui-package.mjs.
/ui-package/standalone/
# Stale copies of the chatbot runtime a 2.x checkout staged at pack time (control/lite-template/,
# ui-package/lite-template/). The runtime left mojulo in 3.0.0; this keeps a leftover staging copy,
# and any bot .env or data inside it, out of a `git add`.
lite-template/
# Generative illustration spikes — visual experiments, not load-bearing.
# They import polygonizer primitives and dump SVGs to lite-template/integration
# (already ignored). Kept on disk for local iteration; never committed.
# Both spike families: *.spike.gen.test.js and the un-.gen'd *.spike.test.js.
*.gen.test.js
*.spike.test.js
# Local spike render dumps (e.g. lib/graph/pixelizer/spike-output/) — generated
# eyes-gate artifacts, recreatable by re-running the spikes; never committed.
spike-output/
# The mobile-suit content pack (weapons, shields, armory, arena/space maps,
# liveries) — game content lives OUTSIDE the repo; canonical home is
# lite-template/integration/archive-mobile-suit/. The substrate reaches it only
# through guarded seams (extraction.plan.md). Never committed.
#
# Exceptions: two import-free *behavior* modules the general controllable engine
# depends on directly (dodge/tackle maneuvers + the AI opponent brain). They carry
# tracked test coverage in controllable-world.test.js and must resolve on a clean
# checkout — behavior, not content — so they are tracked while the rest of the
# pack stays out. See controllable/compose.js EMISSION.
lib/graph/mobile-suit/*
!lib/graph/mobile-suit/ms-maneuvers.js
!lib/graph/mobile-suit/ms-ai.js

# Scratch prototyping scripts (underscore-prefixed) are local-only; they carried
# absolute home-directory paths and were never load-bearing.
scripts/_*.mjs
# npm pack output; publish from it, never commit it.
mojulo-*.tgz
# Precompiled JSX twins, written at prepack by scripts/precompile-jsx.mjs.
*.jsx.mjs
# The repo's LICENSE and NOTICE, copied into each package at pack time (scripts/license-files.mjs).
/LICENSE
/NOTICE
/ui-package/LICENSE
/ui-package/NOTICE
