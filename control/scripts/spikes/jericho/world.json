            "from": "chandler",
            "lines": [
              {
                "id": "dk-1",
                "who": "chandler",
                "text": "[Chandler: You're in. That's the sea pen under the fortress: the supply runs dock there.]"
              },
              {
                "id": "dk-2",
                "who": "coral",
                "text": "[Coral: Guards on the quays. A control room over the head.]"
              },
              {
                "id": "dk-3",
                "who": "chandler",
                "text": "[Chandler: The cliff stair is at the back of the head quay. Your card opens it. Get there without being seen.]"
              }
            ]
          },
          {
            "id": "lesson-sight",
            "on": {
              "begin": 2
            },
            "after": 1.5,
            "from": "chandler",
            "lines": [
              {
                "id": "ls-sight-1",
                "who": "chandler",
                "text": "[Chandler: Watch their eyes. A guard sees what's in front of him, not behind. Your radar shows where they look.]"
              },
              {
                "id": "ls-sight-2",
                "who": "chandler",
                "text": "[Chandler: Crouch behind the crates and they won't see you over them. C to crouch.]"
              }
            ]
          },
          {
            "id": "lesson-dart",
            "on": {
              "begin": 2
            },
            "after": 30,
            "from": "chandler",
            "lines": [
              {
                "id": "ls-dart-1",
                "who": "chandler",
                "text": "[Chandler: The sentry by the stair won't move. Put him to sleep with a dart, or come up behind him and take him down: E.]"
              },
              {
                "id": "ls-dart-2",
                "who": "chandler",
                "text": "[Chandler: Drag a sleeping guard out of sight. If his friends find him, they'll know.]"
              }
            ]
          },
          {
            "id": "spotted",
            "on": {
              "event": "alarm:spotted"
            },
            "from": "chandler",
            "lines": [
              {
                "id": "al-1",
                "who": "chandler",
                "text": "[Chandler: He saw something. Get out of his sight before he's sure.]"
              }
            ]
          },
          {
            "id": "alert",
            "on": {
              "event": "alarm:found"
            },
            "from": "chandler",
            "lines": [
              {
                "id": "al-2",
                "who": "chandler",
                "text": "[Chandler: You've been made. Break their line of sight and hide until they give up.]"
              }
            ]
          },
          {
            "id": "stood-down",
            "on": {
              "event": "alarm:clear"
            },
            "from": "chandler",
            "lines": [
              {
                "id": "al-3",
                "who": "chandler",
                "text": "[Chandler: They've stood down. Carry on, quieter this time.]"
              }
            ]
          }
        ]
