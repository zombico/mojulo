            "from": "chandler",
            "lines": [
              {
                "id": "ls-climb-1",
                "who": "chandler",
                "text": "[Chandler: cargo in the way. Run at the low crates to go over them; hold W into the container to climb it.]"
              },
              {
                "id": "ls-climb-2",
                "who": "chandler",
                "text": "[Chandler: off its far side you'll hang by your hands. S to let go.]"
              }
            ]
          }
