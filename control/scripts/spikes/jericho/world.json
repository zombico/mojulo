                "id": "op-4",
                "who": "chandler",
                "text": "Small update in the mission params. Orders from high up."
              },
              {
                "id": "op-5",
                "who": "coral",
                "text": "We're almost at the approach. What's the situation?"
              },
              {
                "id": "op-6",
                "who": "chandler",
                "text": "There's a package in the front of the ship. Instructions will be there."
              }
