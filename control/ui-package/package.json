{
  "name": "mojulo-ui",
  "version": "2.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "The mojulo dashboard: the prebuilt local web UI over the same ~/.mojulo state the mojulo MCP server drives. It runs on the exact mojulo version it was published with and binds to 127.0.0.1.",
  "author": "Franz Ombico",
  "homepage": "https://mojulo.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zombico/mojulo.git",
    "directory": "control/ui-package"
  },
  "bugs": {
    "url": "https://github.com/zombico/mojulo/issues"
  },
  "keywords": [
    "mojulo",
    "mcp",
    "dashboard"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mojulo-dashboard": "bin/mojulo-dashboard.mjs"
  },
  "files": [
    "bin/",
    "standalone/",
    "!standalone/.env",
    "!standalone/.env.*",
    "!standalone/data/**",
    "!standalone/lite-template/**",
    "!standalone/**/*.nft.json",
    "!standalone/**/*.test.js",
    "lite-template/",
    "!lite-template/models/**"
  ],
  "scripts": {
    "prepack": "node ../scripts/stage-ui-package.mjs"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "mojulo": "2.1.0",
    "officeparser": "^5.2.2",
    "open": "^11.0.0",
    "pdf2json": "^4.0.0",
    "puppeteer-core": "^25.12.0"
  },
  "optionalDependencies": {
    "manifold-3d": "^3.5.1",
    "node-web-audio-api": "^2.0.0",
    "openscad-wasm-prebuilt": "^1.2.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.34.5"
  }
}
