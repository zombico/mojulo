# Mojulo-Lite Control Plane — local env example

# Path to lite-template source, used by DockerDeployer to package artifacts
LITE_TEMPLATE_PATH=../lite-template

# Where generated bot zip artifacts get written (also served for download)
ARTIFACTS_DIR=./data/artifacts

# SQLite database file (auto-created on first run)
SQLITE_PATH=./data/mojulo-lite.db

# Local filesystem storage root for uploaded documents (parsed text + originals)
STORAGE_ROOT=./data/storage

# Default Docker image tag the generated docker-compose.yml references.
# Pin to the exact published GHCR image so users pull the vector-capable build.
BOT_IMAGE=ghcr.io/zombico/mojulo-bot:0.5.1

# Override the image used for cloud (Fly.io) deploys. If unset, FlyDeployer
# falls back to BOT_IMAGE. Only set this if your local docker-compose path
# needs a different tag than what Fly should pull (e.g. BOT_IMAGE points at a
# local laptop tag like `mojulo/bot:latest`).
# MOJULO_CLOUD_IMAGE=ghcr.io/zombico/mojulo-bot:0.5.1

# Default port the bot container exposes
BOT_DEFAULT_PORT=3000

# Optional login on the control plane. Leave blank to disable (default).
# Set BOTH to gate every route behind /login (except /api/health).
# Sessions are signed with the password itself — rotating the password
# invalidates all outstanding sessions automatically.
# This is a last-line-of-defense affordance — do NOT expose the control plane to
# the public internet, and front it with HTTPS (reverse proxy) if you enable it.
CONTROL_PLANE_USER=
CONTROL_PLANE_PASSWORD=

# Remote MCP server (Claude Desktop / Claude Code can drive the control plane
# as a tool host). Leaving this blank disables the /api/mcp route entirely —
# it returns 404 instead of accepting bearer auth. Set to a long random string
# and add `Authorization: Bearer <value>` to your Claude MCP client config.
# See docs/mcp-integration.md for setup.
CONTROL_PLANE_MCP_KEY=

# App paradigm — Node-driven inference fulfillment (opt-in).
# When unset (the default), app `/api/app-inference/envelope` requests are
# fulfilled by the operator's Claude Code session running
# `/loop /get_catalyst run-inference-worker`. With the value below set, the
# control plane also starts an in-process poller that spawns a one-shot
# `claude --print` subprocess per task — the operator's main session stays
# free. Both fulfillers can coexist; FIFO single-claim from the queue
# ensures each task is fulfilled by exactly one. See docs/mcp-integration.md
# (Node-driven fulfillment section).
# MOJULO_AGENT_RUNTIME=claude-code-headless

# Trigger runtime — composer-anchored activation daemons (opt-in).
# When unset (the default), `bind_trigger` calls still succeed and the
# binding row is durable, but nothing fires — the daemon isn't running.
# Set to `enabled` to start the scheduler daemon at boot; on next reload
# (after any bind_trigger / unbind_trigger), the daemon picks up active
# triggers and registers them. SIGTERM drains in-flight fires before exit.
# Symmetric with MOJULO_AGENT_RUNTIME's opt-in posture so operators who
# haven't configured automation don't get background daemons by default.
# Webhook (Phase 2) and watch (Phase 3) daemons will share this gate.
# MOJULO_TRIGGER_RUNTIME=enabled

# Unified runtime daemon host (opt-in). Starts the scheduler + app-runtime
# daemons under a single loopback host process. When enabled, set per-daemon
# gates below to `disabled` to skip a specific daemon.
# MOJULO_DAEMONS=enabled
# MOJULO_APP_RUNTIME=enabled

# MCP tool-layer telemetry. On by default: one structured stderr line + one
# SQLite row per tool call (timing, status, input SHAPE — top-level key names +
# byte size only, never values or conversation content). Read it in-session via
# the `get_tool_telemetry` tool or on the `/observability` dashboard page. Set
# to `off` to disable recording entirely.
# MOJULO_MCP_TELEMETRY=off
#
# DEBUG capture (off by default). Additionally stores truncated input/result
# JSON (~4KB each) on every telemetry row. WARNING: inputs can carry pasted
# documents and env-adjacent strings — this writes those VALUES to the control
# DB. Leave off unless actively debugging a specific handler.
# MOJULO_MCP_TELEMETRY_CAPTURE=full
#
# Soft per-tool timeout (ms, default 120000). On expiry the session is unblocked
# and the call is flagged `timeout`; the handler is NOT killed (its eventual
# outcome is recorded as `late_settle`). Long-running work should use the async
# jobs ring instead of raising this. Per-tool overrides are set at registration.
# MOJULO_MCP_TOOL_TIMEOUT_MS=120000
